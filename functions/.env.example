# Ryan Games — Netlify Functions environment
# Copy to functions/.env (or set these in the Netlify dashboard under
# Site settings → Environment variables). NEVER commit real values.

# ── Data layer (required) ───────────────────────────────
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — SERVER ONLY. Never expose in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin publish key ───────────────────────────────────
# Must match "مفتاح النشر" (publishKey) saved in the admin panel settings.
ADMIN_WRITE_KEY=ryan2026

# ── AI translation (optional) ───────────────────────────
# "openai" or "google"
AI_TRANSLATE_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
AI_MODEL=gpt-4o-mini
